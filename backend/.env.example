# Copy to .env for local development. Bind the development server to 127.0.0.1.
GRABIT_ENV=development
# Optional locally; REQUIRED in production (at least 24 characters).
GRABIT_API_KEY=
GRABIT_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GRABIT_DOWNLOAD_DIR=.downloads
GRABIT_MAX_DURATION_SECONDS=1200
GRABIT_MAX_FILE_MB=150
GRABIT_JOB_TIMEOUT_SECONDS=600
GRABIT_FILE_TTL_SECONDS=900
